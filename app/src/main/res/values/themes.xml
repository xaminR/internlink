<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Internlink" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/secondary</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Compatibility -->
        <item name="isMaterial3Theme">true</item>
        <item name="colorError">@color/error</item>
        <item name="colorOutline">@color/outline</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Internlink.HeadlineLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Internlink.BodyLarge</item>
    </style>

    <style name="Theme.Internlink" parent="Base.Theme.Internlink" />

    <style name="TextAppearance.Internlink.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_heading</item>
    </style>

    <style name="TextAppearance.Internlink.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_body</item>
    </style>

    <style name="Widget.Internlink.LogoutButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/logout_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
</resources>